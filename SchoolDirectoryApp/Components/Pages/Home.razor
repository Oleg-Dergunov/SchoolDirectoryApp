@page "/"
@rendermode InteractiveServer
@using SchoolDirectoryApp.Models
@using SchoolDirectoryApp.Components
@using SchoolDirectoryApp.Services
@inject ISchoolService SchoolService

<PageTitle>School Directory</PageTitle>

<div class="row">
    <div class="col-lg-8">
        <h1 class="mb-3">Welcome to School Directory App!</h1>

        <p class="lead mb-4">
            Browse schools from the Edutots network. Search by name, sort the list,
            and open any school to see who runs it and how to contact them.
        </p>

        <a class="btn btn-primary" href="schools">Browse schools</a>
    </div>
</div>

<div class="mt-5">
    @if (error)
    {
        <p class="text-danger">Unable to retrieve school data.</p>
    }
    else if (schools == null)
    {
        <p>Loading statistics...</p>
    }
    else
    {
        <SchoolStats Schools="schools" />
    }
</div>

@code {
    private List<School>? schools;
    private bool error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            schools = await SchoolService.GetSchoolsAsync();
        }
        catch (Exception)
        {
            error = true;
        }
    }
}