@using SchoolDirectoryApp.Models

<div class="card border-primary mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">School Details</h4>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnClose.InvokeAsync()">Close</button>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">School ID</dt>
            <dd class="col-sm-9">@School.SchoolId</dd>

            <dt class="col-sm-3">School Name</dt>
            <dd class="col-sm-9">@School.SchoolName</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@School.Address</dd>

            <dt class="col-sm-3">Phone No</dt>
            <dd class="col-sm-9">@School.PhoneNo</dd>

            <dt class="col-sm-3">Email Address</dt>
            <dd class="col-sm-9">@School.EmailAddress</dd>

            <dt class="col-sm-3">Proprietor</dt>
            <dd class="col-sm-9">@School.ProprietorFullName</dd>

            <dt class="col-sm-3">Head</dt>
            <dd class="col-sm-9">@School.HeadFullName</dd>
        </dl>
    </div>
</div>

@code {
    [Parameter] public School School { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
}