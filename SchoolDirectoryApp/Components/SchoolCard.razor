@using SchoolDirectoryApp.Models

<article class="id-card @(IsSelected ? "is-selected" : "")">
    <div class="id-band">
        <h3 class="id-name">@School.SchoolName</h3>
    </div>

    <div class="id-body">
        <dl class="id-facts">
            <div><dt>Head</dt><dd>@School.HeadFullName</dd></div>
            <div><dt>Proprietor</dt><dd>@School.ProprietorFullName</dd></div>
            <div><dt>Address</dt><dd class="clamp">@School.Address</dd></div>
        </dl>
    </div>

    <div class="id-foot">
        <button class="btn btn-outline-primary flex-grow-1" @onclick="SelectAsync">View details</button>

        <button class="btn btn-outline-primary fav-btn @(IsFavourite ? "is-on" : "")"
                @onclick="ToggleFavouriteAsync"
                aria-pressed="@(IsFavourite ? "true" : "false")"
                aria-label="Favourite @School.SchoolName"
                title="@(IsFavourite ? "Remove from favourites" : "Add to favourites")">
            <span class="icon @(IsFavourite ? "icon-star-fill" : "icon-star")" aria-hidden="true"></span>
        </button>
    </div>
</article>

@code {
    [Parameter] public School School { get; set; } = default!;
    [Parameter] public EventCallback<School> OnSelect { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsFavourite { get; set; }
    [Parameter] public EventCallback<School> OnToggleFavourite { get; set; }

    private Task SelectAsync() => OnSelect.InvokeAsync(School);

    private Task ToggleFavouriteAsync() => OnToggleFavourite.InvokeAsync(School);
}